---
import AboutHost from "../components/AboutHost.astro";
import BookingTestimonials from "../components/BookingTestimonials.astro";
import FeatureBar from "../components/FeatureBar.astro";
import HeroSection from "../components/HeroSection.astro";
import PageInteractions from "../components/PageInteractions.astro";
import ServicesSection from "../components/ServicesSection.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
	<SiteHeader />
	<main class="flex-grow">
		<HeroSection />
		<FeatureBar />
		<div class="ocean-field">
			<AboutHost />
			<ServicesSection />
			<BookingTestimonials />
		</div>
	</main>
	<SiteFooter />
	<PageInteractions />
</BaseLayout>
