---
import Icon from "./Icon.astro";
import { images, partnerBenefits } from "../data/site";
---

<section class="w-full border-b border-primary/10 px-md py-xl" id="services">
	<div class="mx-auto max-w-container-max">
		<div class="reveal mx-auto mb-xl max-w-3xl rounded-sm border-2 border-primary bg-white/82 p-lg text-center shadow-crisp-offset backdrop-blur-sm">
			<div class="mb-4 flex justify-center">
				<Icon name="auto_awesome" class="text-secondary text-5xl" />
			</div>
			<h2 class="font-headline-lg text-5xl uppercase text-primary">Annapolis Trivia for the Local Community</h2>
			<p class="mt-2 font-label-caps text-xs uppercase text-on-surface-variant">
				Connecting people, one question at a time
			</p>
		</div>

		<div class="grid grid-cols-1 gap-gutter md:grid-cols-12">
			<div class="reveal group relative overflow-hidden rounded-sm border-2 border-outline-variant bg-white/90 p-lg backdrop-blur-sm transition-all hover:border-primary hover:shadow-crisp-md md:col-span-8">
				<div class="flex flex-col gap-lg md:flex-row">
					<div class="flex-1">
						<div class="mb-sm flex items-center gap-2">
							<Icon name="store" class="text-primary" />
							<h3 class="font-headline-lg text-2xl uppercase text-primary">The Small Business Partnership</h3>
						</div>
						<p class="font-body-md mb-md text-on-surface-variant">
							Turn slow nights into your busiest shifts. Our community-focused trivia brings regulars and new
							faces together over local craft brews and great food.
						</p>
						<ul class="mb-lg space-y-sm">
							{
								partnerBenefits.map((benefit) => (
									<li class="flex items-center gap-sm text-sm font-medium text-on-surface">
										<Icon name="check_circle" class="text-secondary text-lg" />
										{benefit}
									</li>
								))
							}
						</ul>
						<a
							class="inline-flex items-center gap-xs border-b-2 border-secondary pb-1 font-label-caps uppercase text-secondary transition-all group-hover:gap-sm"
							href="#booking-form"
						>
							Partner With Us
							<Icon name="arrow_forward" class="text-sm" />
						</a>
					</div>
					<div class="h-48 w-full shrink-0 overflow-hidden rounded-sm border border-outline-variant bg-surface-container p-1 md:h-auto md:w-64">
						<img
							src={images.partner}
							alt="Local bar trivia crowd"
							class="h-full w-full rounded-sm object-cover brightness-90 grayscale transition-all duration-700 group-hover:scale-105 group-hover:grayscale-0"
							loading="lazy"
						/>
					</div>
				</div>
			</div>

			<div class="reveal reveal-delay-1 relative flex flex-col justify-between overflow-hidden rounded-sm border-2 border-primary bg-primary p-lg text-on-primary md:col-span-4">
				<div class="absolute -bottom-4 -right-4 opacity-10">
					<Icon name="cake" class="text-9xl" />
				</div>
				<div>
					<div class="mb-md flex h-12 w-12 items-center justify-center rounded-sm bg-secondary">
						<Icon name="celebration" class="text-on-secondary" />
					</div>
					<h3 class="font-headline-lg mb-sm text-2xl uppercase">Private &amp; Corporate Galas</h3>
					<p class="text-sm leading-relaxed text-primary-fixed-dim/90">
						Whether it is a birthday bash or a corporate retreat, we bring professional energy and top-tier tech
						to any venue in town.
					</p>
				</div>
				<div class="mt-lg border-t border-white/10 pt-md">
					<p class="mb-base text-[10px] font-bold uppercase text-primary-fixed-dim/60">Inquire for Custom Quote</p>
					<a class="font-headline-lg text-2xl uppercase transition-colors hover:text-secondary" href="#booking-form">
						Book an Event
					</a>
				</div>
			</div>

			<div class="reveal reveal-delay-1 group relative overflow-hidden rounded-sm border-2 border-outline-variant bg-white/90 p-lg backdrop-blur-sm md:col-span-4">
				<div class="mb-sm flex items-start justify-between">
					<h3 class="font-headline-lg text-2xl uppercase text-primary">The Adults' Social Hub</h3>
					<Icon name="wine_bar" class="text-secondary" />
				</div>
				<p class="mb-md text-sm text-on-surface-variant">
					Our mission is creating space for the adult community to bond over shared knowledge and friendly rivalry.
				</p>
				<div class="border-t border-outline-variant pt-sm">
					<p class="font-label-caps text-xs uppercase text-secondary">Join the Community Movement</p>
				</div>
			</div>

			<div class="reveal reveal-delay-2 relative flex items-center gap-lg rounded-sm border-2 border-outline-variant bg-white/70 p-lg backdrop-blur-md md:col-span-8">
				<div class="weathered-wood absolute inset-0 opacity-5"></div>
				<div class="relative z-10 hidden shrink-0 sm:block">
					<div class="h-20 w-20 rotate-3 rounded-sm border-2 border-secondary bg-white p-1 transition-transform duration-500 hover:rotate-0">
						<img src={images.award} alt="Local business planning" class="h-full w-full rounded-sm object-cover" loading="lazy" />
					</div>
				</div>
				<div class="relative z-10">
					<div class="mb-1 flex items-center gap-2">
						<Icon name="event_available" class="text-primary text-sm" />
						<h4 class="font-label-caps text-xs uppercase text-primary">Built for the First Night and the Follow-Up</h4>
					</div>
					<p class="text-sm leading-relaxed text-on-surface">
						A strong trivia partnership needs more than a host and a speaker. We help think through timing,
						table flow, promotion, prizes, and how to turn a first event into a repeatable night people remember.
					</p>
					<p class="mt-base text-[10px] font-bold uppercase text-secondary">Launch planning, pacing, and post-event follow-through</p>
				</div>
			</div>
		</div>
	</div>
</section>
