---
import Icon from "./Icon.astro";
import LogoMark from "./LogoMark.astro";
import { images, navLinks, site } from "../data/site";

const mobileLinks = [{ label: "Home", href: "/" }, { label: "About Founder", href: "/about-me" }, ...navLinks];
---

<nav class="sticky top-0 z-50 flex w-full items-center justify-between border-b-2 border-primary bg-surface/90 px-md py-sm backdrop-blur-sm lg:px-lg">
	<a class="flex min-w-0 items-center gap-2 text-primary" href="/" aria-label={`${site.name} home`}>
		<LogoMark class="h-10 w-10 shrink-0" />
		<span class="font-headline-lg text-2xl font-normal uppercase">{site.name}</span>
	</a>

	<div class="hidden items-center gap-lg md:flex">
		{
			navLinks.map((link) => (
				<a
					class:list={[
						"font-label-caps text-label-caps uppercase transition-colors hover:text-secondary",
						link.featured
							? "border-b-4 border-secondary pb-1 text-primary"
							: "text-on-surface-variant",
					]}
					href={link.href}
					target={link.external ? "_blank" : undefined}
					rel={link.external ? "noreferrer" : undefined}
				>
					{link.label}
				</a>
			))
		}
	</div>

	<div class="flex items-center gap-md">
		<details class="mobile-menu relative md:hidden">
			<summary
				class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-sm border-2 border-primary text-primary transition-colors hover:bg-primary hover:text-on-primary"
				aria-label="Open navigation menu"
			>
				<Icon name="menu" class="text-3xl" />
			</summary>
			<div class="absolute right-0 top-12 w-64 rounded-sm border-2 border-primary bg-surface-container-lowest p-sm shadow-crisp-offset">
				{
					mobileLinks.map((link) => (
						<a
							class:list={[
								"flex items-center justify-between border-b border-outline-variant px-sm py-sm font-label-caps text-xs uppercase text-primary last:border-b-0 hover:text-secondary",
								link.label === "Instagram" && "bg-secondary/10 text-secondary",
								link.featured && "text-secondary",
							]}
							href={link.href}
							target={link.external ? "_blank" : undefined}
							rel={link.external ? "noreferrer" : undefined}
						>
							<span class="flex items-center gap-2">
								{link.label === "Instagram" && <Icon name="instagram" class="h-4 w-4" />}
								{link.label}
							</span>
							<Icon name={link.external ? "open_in_new" : "arrow_forward"} class="text-sm" />
						</a>
					))
				}
			</div>
		</details>
		<a
			class="h-10 w-10 overflow-hidden rounded-full border-2 border-primary p-0.5 transition-transform hover:scale-105"
			href="/about-me"
			aria-label="About the founder"
		>
			<img src={images.host} alt="Trivia host" class="h-full w-full rounded-full object-cover" loading="eager" />
		</a>
	</div>
</nav>
