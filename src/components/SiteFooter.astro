---
import Icon from "./Icon.astro";
import LogoMark from "./LogoMark.astro";
import { footerLinks, site } from "../data/site";
---

<footer class="relative w-full overflow-hidden border-t-4 border-secondary bg-primary px-lg py-xl text-on-primary">
	<div class="weathered-wood absolute inset-0 opacity-5"></div>
	<div class="relative z-10 mx-auto flex max-w-container-max flex-col items-center justify-between gap-md md:flex-row">
		<div class="flex flex-col items-center gap-xs text-center md:items-start md:text-left">
			<div class="mb-2 flex items-center gap-2">
				<LogoMark class="h-8 w-8 shrink-0" variant="light" />
				<span class="font-headline-lg text-xl uppercase">{site.name}</span>
			</div>
			<p class="text-xs text-primary-fixed-dim/60">
				&copy; {site.established} {site.name}. Anchored in the heart of {site.location}.
			</p>
		</div>

		<div class="flex flex-wrap justify-center gap-md">
			{
				footerLinks.map((link) => (
					<a
						class="font-label-caps text-xs uppercase text-primary-fixed-dim/80 transition-all hover:text-secondary-container"
						href={link.href}
					>
						{link.label}
					</a>
				))
			}
		</div>
	</div>
</footer>
