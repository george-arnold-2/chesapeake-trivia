---
import Icon from "./Icon.astro";
import { hostHighlights, images, site } from "../data/site";
---

<section class="ocean-field border-b border-primary/10 py-xl" id="about-host">
	<div class="mx-auto flex max-w-container-max flex-col items-center gap-xl px-md md:flex-row">
		<div class="reveal flex w-full justify-center overflow-visible px-md md:w-1/3 md:px-0">
			<div class="relative max-w-full">
				<div class="absolute inset-0 -z-10 scale-110 rounded-full bg-secondary/10 blur-xl"></div>
				<div
					id="parallax-host"
					class="h-60 w-60 overflow-hidden rounded-full border-4 border-primary bg-white p-1 shadow-crisp-lg transition-transform duration-300 ease-out sm:h-64 sm:w-64 md:h-72 md:w-72 lg:h-80 lg:w-80"
				>
					<img
						src={images.host}
						alt="The host of Chesapeake Trivia"
						class="h-full w-full rounded-full object-cover"
						loading="lazy"
					/>
				</div>
			</div>
		</div>

		<div class="reveal reveal-delay-1 w-full space-y-md rounded-sm border border-white/60 bg-white/80 p-md shadow-crisp-offset backdrop-blur-sm md:w-2/3 md:p-lg">
			<h2 class="font-headline-lg text-4xl uppercase text-primary">Meet Your Master of Ceremonies</h2>
			<p class="font-body-lg leading-relaxed text-on-surface">
				With years of hosting and theatrical experience, our host brings flavor, pace, and infectious energy
				to every game. The trick is using that energy in service of the room, not taking it over, so the crowd
				feels welcomed, engaged, and ready to come back.
			</p>

			<div class="grid grid-cols-1 gap-md pt-sm sm:grid-cols-2">
				{
					hostHighlights.map((item) => (
						<div class="flex items-start gap-sm">
							<Icon name={item.icon} class="text-secondary" />
							<div>
								<p class="font-label-caps text-sm uppercase text-primary">{item.title}</p>
								<p class="text-sm text-on-surface-variant">{item.description}</p>
							</div>
						</div>
					))
				}
			</div>

			<div class="flex flex-wrap gap-md pt-md">
				<a
					class="cta-link inline-flex items-center gap-2 border-b-2 border-primary pb-1 font-label-caps uppercase text-primary transition-all hover:gap-4 hover:text-secondary"
					href="/about-me"
				>
					About the Founder
					<Icon name="arrow_forward" class="text-sm" />
				</a>
				
				<a
					class="cta-link inline-flex items-center gap-2 border-b-2 border-secondary pb-1 font-label-caps uppercase text-secondary transition-all hover:gap-4"
					href={site.instagramUrl}
					target="_blank"
					rel="noreferrer"
				>
					Follow the Host
					<Icon name="instagram" class="h-4 w-4" />
				</a>
			</div>
		</div>
	</div>
</section>
